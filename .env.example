# Copie para .env e preencha localmente. NUNCA commite o .env (repositório público).
# Todos os valores abaixo são fictícios.

# Mensageria: "simulador" (desenvolvimento) ou "cloud_api" (produção) — ADR-0004
MENSAGERIA=simulador

# API
PORTA=3000

# Supabase do homelab (ambiente de desenvolvimento e homologação)
# Pooler (Supavisor) em modo sessão: usuário = postgres.<POOLER_TENANT_ID>. Senha com caracteres especiais vai codificada (URL).
DATABASE_URL=postgres://postgres.<tenant>:<senha-do-postgres>@<ip-do-homelab>:5432/postgres
SUPABASE_URL=http://<ip-do-homelab>:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa offline: docker compose --profile banco-local up e
# DATABASE_URL=postgres://postgres@db:5432/claudia

# WhatsApp Cloud API (só com MENSAGERIA=cloud_api)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque-por-um-valor-aleatorio
WHATSAPP_APP_SECRET=

# Claude API
ANTHROPIC_API_KEY=
