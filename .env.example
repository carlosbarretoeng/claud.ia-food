# Copie para .env e preencha localmente. NUNCA commite o .env (repositório público).
# Todos os valores abaixo são fictícios.

# Mensageria: "simulador" (desenvolvimento) ou "cloud_api" (produção) — ADR-0004
MENSAGERIA=simulador

# API
PORTA=3000

# Banco: no Docker o compose.yaml já define DATABASE_URL (Postgres local sem senha, só desenvolvimento)
# DATABASE_URL=

# WhatsApp Cloud API (só com MENSAGERIA=cloud_api)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque-por-um-valor-aleatorio
WHATSAPP_APP_SECRET=

# Claude API
ANTHROPIC_API_KEY=
